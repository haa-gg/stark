{
  "manifest_version": 3,
  "name": "Stark - Pathfinder 2e AI",
  "version": "1.3",
  "description": "Your AI assistant for Pathfinder 2e.",
  "permissions": [
    "sidePanel",
    "storage",
    "identity"
  ],
  "host_permissions": [
    "https://*.google.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://openrouter.ai/*",
    "https://docs.googleapis.com/*",
    "https://api.groq.com/*",
    "https://*.pathbuilder2e.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Stark AI"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "rulebook.txt"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}